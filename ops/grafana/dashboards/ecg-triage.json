{
 "uid": "ecg-triage",
 "title": "ECG triage: agents and receiver",
 "schemaVersion": 39,
 "version": 2,
 "time": {
  "from": "now-1h",
  "to": "now"
 },
 "refresh": "10s",
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "Runs by outcome (15 min)",
   "description": "complete / unreadable / failed / incomplete. A rise in failed or unreadable needs a look.",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 0
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (status) (increase(agent_runs_total[15m]))",
     "legendFormat": "{{status}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    }
   ]
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "Guardrail verdicts by channel (15 min)",
   "description": "How often each channel's answer agreed with screening, was too low, unparsed or refused. Channel fidelity in production.",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 0
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (channel, verdict) (increase(agent_guardrail_total[15m]))",
     "legendFormat": "{{channel}} {{verdict}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    }
   ]
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "Receiver latency p50 / p95 by channel",
   "description": "Time for one triage decision (decide early: about 1.2 s on an RTX 5070).",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.5, sum by (le, channel) (rate(receiver_latency_seconds_bucket[5m])))",
     "legendFormat": "p50 {{channel}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    },
    {
     "refId": "B",
     "expr": "histogram_quantile(0.95, sum by (le, channel) (rate(receiver_latency_seconds_bucket[5m])))",
     "legendFormat": "p95 {{channel}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    }
   ]
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "Mean prompt tokens by channel",
   "description": "The communication cost the paper measures: adapter flat, filtered and compact grow with content.",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (channel) (rate(receiver_prompt_tokens_sum[5m])) / sum by (channel) (rate(receiver_prompt_tokens_count[5m]))",
     "legendFormat": "{{channel}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    }
   ]
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "Run duration p50 / p95",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 16
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.5, sum by (le) (rate(agent_run_seconds_bucket[15m])))",
     "legendFormat": "p50",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    },
    {
     "refId": "B",
     "expr": "histogram_quantile(0.95, sum by (le) (rate(agent_run_seconds_bucket[15m])))",
     "legendFormat": "p95",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    }
   ]
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Inter-agent messages per second",
   "description": "Includes refusals by the orchestrator (sender=orchestrator, intent=refused).",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 16
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (sender, intent) (rate(agent_messages_total[5m]))",
     "legendFormat": "{{sender}}: {{intent}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    }
   ]
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "Tool errors (15 min)",
   "description": "Receiver timeouts and failures; each one fell back to a labelled source.",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 24
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (agent, tool) (increase(agent_tool_calls_total{status=\"error\"}[15m]))",
     "legendFormat": "{{agent}} {{tool}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    }
   ]
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "GPU: peak memory and queue",
   "description": "Queue depth > 1 means requests wait for the one GPU.",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 24
   },
   "fieldConfig": {
    "defaults": {
     "unit": "bytes"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "inference_gpu_memory_bytes",
     "legendFormat": "peak GPU memory",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    },
    {
     "refId": "B",
     "expr": "inference_inflight",
     "legendFormat": "requests waiting or running",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    }
   ]
  },
  {
   "id": 100,
   "type": "timeseries",
   "title": "Input noise: median per recording (6 h)",
   "description": "Data drift: clean records sit below 0.02; accuracy starts to fall above 0.03.",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 32
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.5, sum by (le) (rate(perception_input_noise_bucket[6h])))",
     "legendFormat": "median noise",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    },
    {
     "refId": "B",
     "expr": "0.03",
     "legendFormat": "warning threshold",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    }
   ]
  },
  {
   "id": 101,
   "type": "timeseries",
   "title": "Unreadable share: recordings and windows (1 h)",
   "description": "Rising = the inputs changed (devices, electrodes), not the patients.",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 32
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(increase(agent_runs_total{status=\"unreadable\"}[1h])) / sum(increase(agent_runs_total[1h]))",
     "legendFormat": "recordings",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    },
    {
     "refId": "B",
     "expr": "sum(increase(perception_windows_total{readable=\"false\"}[1h])) / sum(increase(perception_windows_total[1h]))",
     "legendFormat": "windows",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    }
   ]
  },
  {
   "id": 102,
   "type": "timeseries",
   "title": "Beat class mix (1 h)",
   "description": "What the perception agent is seeing. A sudden shift with no clinical reason points at the sender or the inputs.",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 40
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (label) (increase(perception_beats_total[1h])) / ignoring(label) group_left sum(increase(perception_beats_total[1h]))",
     "legendFormat": "{{label}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    }
   ]
  },
  {
   "id": 103,
   "type": "timeseries",
   "title": "LLM disagreement with screening (1 h)",
   "description": "Model-quality drift per channel; real-Gemma baseline about 9% under-triage.",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 40
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (channel) (increase(agent_guardrail_total{verdict!=\"agree\"}[1h])) / sum by (channel) (increase(agent_guardrail_total[1h]))",
     "legendFormat": "{{channel}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    },
    {
     "refId": "B",
     "expr": "0.20",
     "legendFormat": "alert threshold (under-triage)",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    }
   ]
  }
 ],
 "tags": [
  "ecg",
  "agents"
 ]
}